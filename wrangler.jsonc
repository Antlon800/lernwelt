{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lernwelt",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // D1 wird nach dem Erstellen der Datenbank hier mit Name und ID eingetragen.
  // Keine Zugangsdaten oder Admin-Codes in diese Datei schreiben.
  "observability": {
    "enabled": true
  }
}