{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lernwelt",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lernwelt-db",
      "database_id": "ef00dcb7-925f-4ae7-837d-854ba35e26ab",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}